# Copy to .env.local at the repo root. Never commit real keys.
# Devnet only. Do not point these at mainnet.

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional. If set, and SOLANA_RPC_URL is empty, the server uses Helius devnet.
HELIUS_API_KEY=
# Circle's official devnet USDC. Override with the mock mint from `pnpm setup -- --mock-usdc`.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional base58 secret keys. If empty, the app generates data/keys/*.json on first launch.
MERCHANT_SECRET_KEY=
AGENT_SECRET_KEY=
PAYER_SECRET_KEY=

MERCHANT_NAME=Amaka Studio
MERCHANT_CITY=Lagos
MERCHANT_EMAIL=amaka@amaka.studio

# Public origin used in pay links and emails.
APP_URL=http://localhost:3000
# The dev/start port comes from PORT in the shell (default 3000), e.g. PORT=3010 pnpm dev.

# Free-form invoices call OpenAI structured outputs when LLM_API_KEY is set.
# The key is server-only. Never put it in NEXT_PUBLIC_ or client code.
# Without a key, direct invoice commands still run and free-form sentences are refused.
PAYLINK_DEMO_MODE=1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional. Without RESEND_API_KEY, PayLink does not send email and does not claim that it did.
# RESEND_FROM must be a sender Resend allows. Messages go only to a valid client email.
RESEND_API_KEY=
RESEND_FROM=PayLink <receipts@example.com>

# x402 prices and the agent wallet budget, in USDC.
X402_PDF_PRICE_USDC=0.25
X402_REMINDER_PRICE_USDC=0.05
X402_QUOTE_TTL_SECONDS=600
BUDGET_TOTAL_USDC=5
BUDGET_PER_CALL_USDC=0.5
BUDGET_APPROVE_ABOVE_USDC=0.1

# Optional remote facilitator. Leave empty to settle in-process with @x402/svm.
# Example: https://x402.org/facilitator
X402_FACILITATOR_URL=

# Used by docker compose / Caddy. Not required for `pnpm dev`.
DOMAIN=pay.example.com

# Access gate for the merchant side (dashboard, agent, wallet, settings).
# Leave PAYLINK_ACCESS_CODE empty to turn the gate off (local dev). Matching is case-insensitive.
# Payer pages, receipts, and raw /api/x402/* routes stay open either way. Do not hardcode the code.
PAYLINK_ACCESS_CODE=
# Random string used to sign the access cookie, e.g. `openssl rand -base64 32`.
PAYLINK_SESSION_SECRET=

# Optional live cross-chain payments (Aurora Intents). Leave empty to disable.
# Keep both values SERVER-ONLY; never use NEXT_PUBLIC_ for these.
AURORA_INTENTS_API_KEY=
SOLANA_MAINNET_RPC_URL=
