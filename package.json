{
  "name": "paylink",
  "private": true,
  "version": "0.1.0",
  "description": "PayLink — AI invoices settled in Solana USDC, with Aurora Intents and x402. Encode Club Solana Hackathon 2026.",
  "scripts": {
    "dev": "pnpm --filter paylink-solana dev",
    "build": "pnpm --filter paylink-solana build",
    "start": "pnpm --filter paylink-solana start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "devnet": "pnpm --filter paylink-solana run setup",
    "pay": "pnpm --filter paylink-solana pay"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  }
}
